<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pembaruan otomatis: unduh APK + buka installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- GPS (fase 4) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Laporan aktivitas (fase 3): UsageStats butuh izin khusus via Settings -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ZXAgent"
        android:allowBackup="false">

        <!-- FileProvider utk APK installer (pembaruan otomatis) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".StatusActivity" android:exported="false" />

        <!-- Pairing device ortu (device admin layer) -->
        <activity android:name=".PasangActivity" android:exported="false" />

        <!-- Layar blokir ditampilkan dari service saat sesi habis / curfew -->
        <activity
            android:name=".BlokirActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true" />

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Fase 5: aksesibilitas utk deteksi app depan (blokir per-app via overlay) -->
        <service
            android:name=".AksesService"
            android:exported="false"
            android:label="ZX Agent — blokir app"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/akses_service" />
        </service>

        <!-- Device Admin: kunci layar + anti-uninstall (fase 3) -->
        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="false">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Fase 4: daily engagement reminders (challenge 09:00 + streak 20:00) -->
        <receiver
            android:name=".PenerimaPengingat"
            android:exported="false" />
    </application>
</manifest>
